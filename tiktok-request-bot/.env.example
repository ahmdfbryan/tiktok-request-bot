# Username TikTok kamu (tanpa @), contoh: kokokrunchstudios
TIKTOK_USERNAME=

# Token bot Discord (dari Discord Developer Portal)
DISCORD_TOKEN=

# ID channel Discord tempat antrian request lagu ditampilkan
DISCORD_QUEUE_CHANNEL_ID=

# ID voice channel tempat bot join & stay 24/7 buat mutar lagu dari request.
# Opsional — kalau dikosongkan, bot cuma nampilin antrian teks tanpa main lagu.
DISCORD_VOICE_CHANNEL_ID=

# ID role staff yang boleh pakai command admin (skip, clear, pause, dll). Opsional.
DISCORD_STAFF_ROLE_ID=

# ID server Discord, opsional. Kalau diisi, slash command langsung muncul di server
# itu (untuk development). Kalau dikosongkan, command didaftarkan global (bisa
# butuh waktu sampai ~1 jam untuk muncul di semua server, tapi cocok untuk production).
DISCORD_GUILD_ID=

# Prefix command request di komentar TikTok (default: !request)
REQUEST_COMMAND=!request

# Maksimal request per user yang masih menunggu di antrian (default: 3)
MAX_PENDING_PER_USER=3

# Maksimal panjang judul lagu yang diterima (default: 100 karakter)
MAX_TITLE_LENGTH=100
